# Local Compose works without editing this file. Copy it to .env for custom settings.
APP_PORT=8080
DB_PORT=5434
POSTGRES_PASSWORD=local-knitwork-only
# For running Go directly; Compose provides its own internal database address.
DATABASE_URL=postgres://knitwork:local-knitwork-only@localhost:5434/knitwork?sslmode=disable
APP_ENV=development
APP_ORIGIN=http://localhost:8080
PORT=8080
DEMO_SEED=true
STATIC_DIR=../frontend/out
# Production only: use the Render database internal URL and HTTPS application URL.
# Set APP_ENV=production and DEMO_SEED=false on Render.
# Bootstrap creates an administrator only when this email is absent; it does not reset passwords.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional OpenAI-compatible Chat Completions provider; keep real credentials out of Git.
# Use an HTTPS API base ending in /v1, without /chat/completions.
HELP_API_BASE_URL=
HELP_API_KEY=
HELP_MODEL=
